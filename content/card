
<?php
// 🔹 Hitung total per jenis simpanan
$total_pokok = $total_wajib = $total_sukarela = 0;
$qtotal = mysqli_query($conn, "SELECT * FROM simpan");
while ($t = mysqli_fetch_array($qtotal)) {
  if ($t['tipe_transaksi'] == 'setor') {
    if ($t['jenis_simpanan'] == 'pokok') $total_pokok += $t['jumlah'];
    if ($t['jenis_simpanan'] == 'wajib') $total_wajib += $t['jumlah'];
    if ($t['jenis_simpanan'] == 'sukarela') $total_sukarela += $t['jumlah'];
  } elseif ($t['tipe_transaksi'] == 'tarik') {
    if ($t['jenis_simpanan'] == 'pokok') $total_pokok -= $t['jumlah'];
    if ($t['jenis_simpanan'] == 'wajib') $total_wajib -= $t['jumlah'];
    if ($t['jenis_simpanan'] == 'sukarela') $total_sukarela -= $t['jumlah'];
  }
}
$total_keseluruhan = $total_pokok + $total_wajib + $total_sukarela;
